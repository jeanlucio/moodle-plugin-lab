#!/usr/bin/env bash
# Aplica upgrades pendentes do banco e limpa os caches do Moodle.
# Rode sempre que bumpar version.php, mexer em db/ ou adicionar callbacks em lib.php.
set -euo pipefail

# Moodle 5.x: scripts CLI ficam na raiz do checkout (moodle/admin/cli), não sob public/.
MOODLE="$(cd "$(dirname "$0")/../moodle" && pwd)"
php "$MOODLE/admin/cli/upgrade.php" --non-interactive
php "$MOODLE/admin/cli/purge_caches.php"
echo "upgrade + purge concluídos."
