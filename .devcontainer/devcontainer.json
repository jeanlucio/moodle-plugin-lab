{
  // Define o "nome de batismo" do ambiente, que aparece no canto do VS Code.
  "name": "Moodle 5.2 Vibe Coding",
  
  // Diz ao Codespaces para usar o arquivo "Dockerfile" ao invés de uma máquina padrão.
  // É através dele que o servidor nasce com PHP, MariaDB e as extensões instaladas.
  "build": {
    "dockerfile": "Dockerfile"
  },
  
  // Automatiza a instalação de ferramentas no VS Code do aluno.
  "customizations": {
    "vscode": {
      // Lista de extensões que já vêm instaladas de fábrica na máquina:
      "extensions": [
        "github.copilot",                      // IA para autocompletar código
        "github.copilot-chat",                 // IA para tirar dúvidas de programação no chat
        "bmewburn.vscode-intelephense-client"  // O melhor corretor e assistente para a linguagem PHP
      ]
    }
  },
  
  // Liga o banco de dados MariaDB automaticamente assim que o VS Code abrir.
  "postStartCommand": "sudo service mariadb start",
  
  // Libera as portas que usaremos para acessar o site (8000) e o banco de dados (3306).
  "forwardPorts": [8000, 3306]
}